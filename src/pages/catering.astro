---
// Q2 – Live-Text wörtlich und in Live-Reihenfolge wie /pages/catering (docs/LIVE-INVENTAR.md), V1-Aufbau.
// Preisorientierung ist Live-Text (Prüfpunkt, siehe _agent/staging/T-20261015-05/ERGEBNIS.md).
// Dazu aus V1 (T-20261016-05): Katalog und Pakete aus @/data/catering (bisheriger Webauftritt, ohne Preise;
// PRODUCT-TRUTH: Catering-Katalog bestätigt 05.10.2026). Anrede an Live angepasst (du).
import Base from '@/layouts/Base.astro';
import Picture from '@/components/Picture.astro';
import InquiryForm from '@/components/InquiryForm.astro';
import Arrow from '@/components/Arrow.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { categories, packages } from '@/data/catering';
import stills from '@/data/stills.json';
import { buildService } from '@/lib/seo/schema';

const description =
  'Catering und Live Cooking in Hamburg und Umgebung: Canapés, Flying Buffets und individuelle Menüs mit europäischen, afghanischen und persischen Aromen.';
// Image for the Service schema: the largest WebP of the head photo.
const serviceImage = stills['catering-photo'].webp.reduce((a, b) => (b.width > a.width ? b : a)).src;
---

<Base
  title="Royal Spices Catering & Live Cooking"
  description={description}
  schema={[
    buildService({
      origin: Astro.site ?? Astro.url.origin,
      path: '/catering/',
      name: 'Royal Spices Catering & Live Cooking',
      description,
      serviceType: 'Catering',
      images: [serviceImage],
    }),
  ]}
>
  <section class="page-head cat-head" aria-labelledby="cat-title">
    <div class="wrap grid">
      <div class="cat-head__body opener">
        <Breadcrumbs
          items={[
            { name: 'Start', path: '/' },
            { name: 'Catering & Live Cooking', path: '/catering/' },
          ]}
        />
        <h1 class="display-xl" id="cat-title">Royal Spices Catering &amp; Live Cooking</h1>
      </div>
      <figure class="cat-head__figure figure">
        <Picture name="catering-photo" alt="Royal-Spices-Catering bei einem Business-Event: Menükarte als Aufsteller, dahinter eine Theke mit angerichteten Löffelgerichten." sizes="(min-width: 64rem) 34vw, 92vw" loading="eager" fetchpriority="high" />
      </figure>
    </div>
  </section>

  <section class="section--tight" aria-labelledby="cat-kulinarik">
    <div class="wrap split">
      <div class="split__a opener">
        <p class="eyebrow">Royal Spices · Culinary Experiences</p>
        <h2 class="display-l" id="cat-kulinarik">Exklusive Kulinarik für besondere Momente.</h2>
      </div>
      <div class="split__b">
        <p class="lead">Von eleganten Canapés über Flying Buffets bis zu individuell komponierten Menüs: Royal Spices verbindet präzises Handwerk mit modernen europäischen, afghanischen und persischen Aromen. Persönlich konzipiert und auf Wunsch vor Ort vollendet.</p>
      </div>
    </div>
  </section>

  <section class="section band-deep" aria-labelledby="cat-formate">
    <div class="wrap split">
      <div class="split__a opener">
        <h2 class="display-l" id="cat-formate">Unsere Formate</h2>
      </div>
      <div class="split__b">
        <ul class="rows">
          <li>
            <h3 class="display-s">Flying Buffet &amp; Canapés</h3>
            <p>Feine Fingerfood-Kreationen, saisonale Mini-Löffelgerichte und raffinierte Desserts – für Empfänge, Markenveranstaltungen und private Feste.</p>
            <p><strong>Beispiele:</strong> Tuna Tatar · Avocado · Crispy Chili · Sesam / Burrata · Erbsenpesto · Safran-Zitrone / Geschmorte Rinderschulter · Trüffel-Kartoffelpüree / Rotgarnele · Basilikum-Hummus · Safran-Aioli.</p>
          </li>
          <li>
            <h3 class="display-s">Business Lunch &amp; Office Catering</h3>
            <p>Frühstück, Tagungsversorgung, individuell abgestimmte Lunchmenüs und kleine wie große Firmenveranstaltungen.</p>
          </li>
          <li>
            <h3 class="display-s">Live Cooking by Chef Sajad</h3>
            <p>Persönlich zubereitete Menüs und kulinarisches Erlebnis vor Ort – klassisches Handwerk trifft auf kreative Neuinterpretationen.</p>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="cat-katalog">
    <div class="wrap split split--wide">
      <div class="split__a opener">
        <p class="eyebrow">Aus dem Katalog</p>
        <h2 class="display-l" id="cat-katalog">Eine Auswahl für deinen Anlass.</h2>
      </div>
      <div class="split__b menu">
        {
          categories.map((category, index) => (
            <details class="menu__category" open={index === 0}>
              <summary>
                <span class="display-m">{category.title}</span>
                <span class="menu__count small">{category.dishes.length} Gerichte</span>
                <span class="menu__icon" aria-hidden="true" />
              </summary>
              <div class="menu__body">
                <p class="small">{category.intro}</p>
                <ul>
                  {category.dishes.map((dish) => (
                    <li>
                      <span class="menu__dish">{dish.name}</span>
                      <span class="menu__detail">{dish.detail}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section band-deep" aria-labelledby="cat-pakete">
    <div class="wrap split">
      <div class="split__a opener">
        <p class="eyebrow">Pakete</p>
        <h2 class="display-l" id="cat-pakete">Zwei Vorschläge zum Einstieg.</h2>
      </div>
      <div class="split__b packs">
        {
          packages.map((p) => (
            <div class="label pack">
              <p class="eyebrow">{p.size}</p>
              <h3 class="display-m">{p.title}</h3>
              <ul>{p.parts.map((part) => <li>{part}</li>)}</ul>
            </div>
          ))
        }
        <p class="small packs__note">Angaben zu Allergenen erhältst du zur gewählten Menüauswahl.</p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="cat-preise">
    <div class="wrap split">
      <div class="split__a opener">
        <h2 class="display-l" id="cat-preise">Preisorientierung</h2>
      </div>
      <div class="split__b prose">
        <p>Canapés ab 3,90 € · Mini-Löffelgerichte ab 4,20 € · Mini-Desserts ab 4,20 €, jeweils inklusive gesetzlicher Mehrwertsteuer. Verfügbarkeit, Mindestmengen, Personalkosten, Transport und Aufbau werden individuell angeboten.</p>
      </div>
    </div>
  </section>

  <section class="section band-slate" aria-labelledby="cat-hamburg">
    <div class="wrap split">
      <div class="split__a opener">
        <h2 class="display-l" id="cat-hamburg">Für Hamburg und Umgebung</h2>
      </div>
      <div class="split__b prose">
        <p>Du planst ein Event, einen Empfang oder eine Firmenveranstaltung? Wir freuen uns über eine unverbindliche Anfrage mit Datum, Veranstaltungsort, Gästezahl und deinen Wünschen.</p>
        <div class="actions">
          <a class="btn" href="#anfrage">CATERING ANFRAGEN <Arrow dir="down" /></a>
        </div>
      </div>
    </div>
  </section>

  <div class="section band-deep">
    <div class="wrap">
      <InquiryForm topic="catering" heading="Catering-Anfrage" />
    </div>
  </div>
</Base>

<style>
  .cat-head {
    padding-bottom: var(--s-7);
  }

  .cat-head .grid {
    align-items: end;
  }

  .cat-head__body {
    grid-column: 1 / span 7;
  }

  .cat-head__figure {
    grid-column: 9 / span 4;
  }

  .cat-head__figure :global(img) {
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 40%;
  }

  .rows strong {
    color: var(--ink);
  }

  .menu {
    gap: 0;
  }

  .menu__category {
    border-top: 1px solid var(--rule-strong);
  }

  .menu__category:last-child {
    border-bottom: 1px solid var(--rule-strong);
  }

  .menu__category summary {
    display: grid;
    grid-template-columns: 1fr auto 1.5rem;
    align-items: center;
    gap: var(--s-4);
    min-height: 4.5rem;
    padding-block: var(--s-4);
    cursor: pointer;
    list-style: none;
  }

  .menu__category summary::-webkit-details-marker {
    display: none;
  }

  .menu__icon {
    position: relative;
    width: 1rem;
    height: 1rem;
    justify-self: end;
  }

  .menu__icon::before,
  .menu__icon::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto 0;
    height: 1.5px;
    background: var(--saffron);
    transition: transform 0.2s var(--ease-out);
  }

  .menu__icon::after {
    transform: rotate(90deg);
  }

  .menu__category[open] .menu__icon::after {
    transform: rotate(0deg);
  }

  .menu__body {
    padding: 0 0 var(--s-6);
    display: grid;
    gap: var(--s-4);
  }

  .menu__body ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .menu__body li {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    gap: var(--s-2) var(--s-5);
    padding-block: var(--s-3);
    border-top: 1px solid var(--rule);
  }

  .menu__dish {
    font-weight: 600;
  }

  .menu__detail {
    color: var(--ink-2);
  }

  .packs {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-5);
  }

  .pack {
    display: grid;
    gap: var(--s-3);
    align-content: start;
  }

  .pack ul {
    margin: var(--s-2) 0 0;
    padding: 0;
    list-style: none;
  }

  .pack li {
    padding-block: 0.5rem;
    border-top: 1px solid var(--rule);
  }

  .packs__note {
    grid-column: 1 / -1;
  }

  @media (max-width: 63.99rem) {
    .cat-head__body,
    .cat-head__figure {
      grid-column: 1 / -1;
    }

    .cat-head__figure {
      max-width: 26rem;
    }
  }

  @media (max-width: 35.99rem) {
    .menu__category summary {
      grid-template-columns: 1fr 1.5rem;
    }

    .menu__count {
      display: none;
    }

    .menu__body li,
    .packs {
      grid-template-columns: 1fr;
    }
  }
</style>
