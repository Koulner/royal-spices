---
// Text verbatim from the live page royalspices.de/pages/impressum (docs/LIVE-INVENTAR.md, row Q8,
// retrieved 2026-10-15); company details from src/config/site.ts, identical to the live text.
// Legal review by the responsible party is required before launch (docs/PRODUCT-TRUTH.md).
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { site } from '@/config/site';
---

<Base title="Impressum · Royal Spices, Hamburg" description="Impressum von Royal Spices, Sajad Akrami, Hammerdeich 10, 20537 Hamburg.">
  <section class="page-head">
    <div class="wrap">
      <Breadcrumbs
        items={[
          { name: 'Start', path: '/' },
          { name: 'Impressum', path: '/impressum/' },
        ]}
      />
      <h1 class="display-l">Impressum</h1>
      <div class="longform">
        <p><strong>Angaben gemäß § 5 Digitale-Dienste-Gesetz (DDG)</strong></p>

        <h2>Betreiber</h2>
        <p>
          {site.owner}<br />
          {site.name}<br />
          {site.address.street}<br />
          {site.address.postalCode}
          {site.address.city}<br />
          Deutschland
        </p>

        <h2>Kontakt</h2>
        <p>
          Telefon: <a href={site.phone.href}>{site.phone.display}</a><br />
          E-Mail: <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>

        <h2>Umsatzsteuer-ID</h2>
        <p>
          Umsatzsteuer-Identifikationsnummer gemäß § 27a Umsatzsteuergesetz:<br />
          <strong>DE459334343</strong>
        </p>

        <h2>Bildnachweis</h2>
        {/* First paragraph: live text kept as published (M1). Since T-20261022-40 V1 shows the photograph itself on /herkunft-qualitaet/, so the second paragraph credits that use with source. */}
        <p>
          Für die auf royalspices.de verwendete Bergfotografie: „Wakhan, Tajikistan“ von Ninara, lizenziert unter
          <a href="https://creativecommons.org/licenses/by/2.0/deed.de" rel="noopener">Creative Commons CC BY 2.0</a>; Darstellung als Bildausschnitt mit Farbüberlagerung. Dieser Nachweis bezieht sich auf die Originalwebsite. Die hier verwendeten Produkt- und Markenbilder können abweichen.
        </p>
        <p>
          Dieselbe Bergfotografie erscheint auf der Seite <a href="/herkunft-qualitaet/">Herkunft &amp; Qualität</a>:
          <a href="https://www.flickr.com/photos/ninara/43149066365/" rel="noopener">„Wakhan, Tajikistan“</a> von Ninara, Quelle Flickr, lizenziert unter
          <a href="https://creativecommons.org/licenses/by/2.0/deed.de" rel="noopener">CC BY 2.0</a>; Bildausschnitt mit Farbüberlagerung.
        </p>
        <p>
          Darstellungen von Blüte, Safranfäden und Glas: 3D-Visualisierungen im Auftrag von Royal Spices. Fotografien der abgefüllten Gläser und der Veranstaltung sowie die Visualisierung des Theken-Displays: Royal Spices.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .page-head {
    padding-bottom: var(--section-pad);
  }

  /* Breadcrumbs above the h1: the same gap as the .opener grid on the other pages (SEO-C). */
  .page-head :global(.crumbs) {
    margin-bottom: var(--s-5);
  }

  h1 {
    margin-bottom: var(--s-5);
  }

  .longform a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }
</style>
