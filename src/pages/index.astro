---
// Home page (T-20261016-04, Shopify B). Live sections S1–S10 of royalspices.de word for word
// (docs/LIVE-INVENTAR.md; quality as on the label: Grade 1, D3/D4), in Live order:
//   S1 hero        -> HomeJourney (V1 render sequence with the Live hero text, D5)
//   S2 ticker, S3 "Warum Royal Spices?", S4 brand story
//   S5 collection  -> HomeCollection (prices only from the catalog, gift box without price, D7)
//   S6 picture break + S7 "Unsere Wurzeln" (one block on Live: picture beside copy)
//   S8 ritual, S9 business, then two V1 blocks (V1/Live rule, see ERGEBNIS.md), S10 last line.
// Live arrows "↗" are the V1 <Arrow />.
import Base from '@/layouts/Base.astro';
import HomeJourney from '@/components/home/HomeJourney.astro';
import HomeCollection from '@/components/home/HomeCollection.astro';
import Picture from '@/components/Picture.astro';
import Sprig from '@/components/Sprig.astro';
import Arrow from '@/components/Arrow.astro';
import stills from '@/data/stills.json';
import { site } from '@/config/site';
import { formats } from '@/data/product';
import { saffronDishes } from '@/data/catering';
import { buildOrganization, buildWebSite } from '@/lib/seo/schema';

type Variant = { src: string; width: number };
const s = stills as Record<string, { avif: Variant[] }>;
const set = (name: string) => s[name].avif.map((v) => `${v.src} ${v.width}w`).join(', ');
const MOTION = '(prefers-reduced-motion: no-preference)';
const STILL = '(prefers-reduced-motion: reduce)';
const preloads = [
  { href: s['origin-desktop'].avif[0].src, type: 'image/avif', media: `${MOTION} and (min-aspect-ratio: 4/5)`, imagesrcset: set('origin-desktop'), imagesizes: '100vw' },
  { href: s['origin-mobile'].avif[0].src, type: 'image/avif', media: `${MOTION} and (max-aspect-ratio: 4/5)`, imagesrcset: set('origin-mobile'), imagesizes: '100vw' },
  { href: s['arrival-desktop'].avif[0].src, type: 'image/avif', media: `${STILL} and (min-aspect-ratio: 4/5)`, imagesrcset: set('arrival-desktop'), imagesizes: '100vw' },
  { href: s['arrival-mobile'].avif[0].src, type: 'image/avif', media: `${STILL} and (max-aspect-ratio: 4/5)`, imagesrcset: set('arrival-mobile'), imagesizes: '100vw' },
];

// SEO-B: company and site from the schema builders; NAP comes from site.ts. OnlineStore without
// shipping and returns until the customer confirms them (E7).
const origin = Astro.site ?? Astro.url.origin;
const schema = [buildOrganization({ origin }), buildWebSite({ origin })];

// S2
const trust = ['Sorgfältig ausgewählt', 'Herkunft Herat', 'Ganze Safranfäden', 'Genuss mit Charakter'];

// S3
const benefits = [
  { sign: '✧', title: 'Reiner Safran', text: '100 % Safranfäden, ohne Zusätze und Füllstoffe.' },
  { sign: '❀', title: 'Handverlesen', text: 'Sorgfältig ausgewählte ganze Negin-Fäden.' },
  { sign: '⌁', title: 'Aus Herat', text: 'Verbunden mit der Tradition Afghanistans.' },
  { sign: '◇', title: 'Qualität', text: 'Chargenbezogene Analysen auf Anfrage.' },
];

// S8
const ritual = [
  { no: '01', title: 'Fäden dosieren', text: 'Einige Fäden genügen, um deinen Kreationen Farbe und Charakter zu verleihen.' },
  { no: '02', title: 'Sanft ziehen lassen', text: 'Die Fäden in etwas warmem Wasser ziehen lassen – so lösen sich Farbe und Aroma.' },
  { no: '03', title: 'Gerichte veredeln', text: 'Den Aufguss zu Reis, Saucen oder Desserts geben und bewusst genießen.' },
];
---

<Base
  title="Royal Spices – Safran aus Herat"
  description="Ein kostbares Gewürz. Eine außergewöhnliche Herkunft. Handverlesene Safranfäden aus Herat – für Momente, die in Erinnerung bleiben."
  preloads={preloads}
  schema={schema}
>
  <HomeJourney />

  {/* id="herkunft": scripts/journey.ts (unchanged) scrolls here after the last chapter. */}
  <div class="home" id="herkunft">
    {/* S2 */}
    <div class="ticker band-slate">
      <ul class="ticker__list wrap">
        {
          trust.map((t) => (
            <li>
              <span aria-hidden="true">✧</span> {t}
            </li>
          ))
        }
      </ul>
    </div>

    {/* S3 */}
    <section class="section why" id="warum" aria-labelledby="warum-title">
      <div class="wrap">
        <div class="why__head opener">
          <p class="eyebrow">DAS MACHT UNS AUS</p>
          <h2 class="display-l" id="warum-title">Warum Royal Spices?</h2>
        </div>
        <ul class="why__grid">
          {
            benefits.map((b) => (
              <li>
                <span class="why__sign" aria-hidden="true">{b.sign}</span>
                <h3 class="display-s">{b.title}</h3>
                <p>{b.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {/* S4 */}
    <section class="section band-deep story" id="geschichte" aria-labelledby="geschichte-title">
      <div class="wrap grid">
        <div class="story__copy opener">
          <p class="eyebrow">WARUM ROYAL SPICES</p>
          <h2 class="display-l" id="geschichte-title">Reine Zutaten.<br />Echter Geschmack.</h2>
          <p class="lead">
            Von Herat direkt in deine kulinarische Welt: handverlesene Safranfäden, charaktervoll und sorgfältig ausgewählt. Unsere Liebe zur Gastronomie und unsere Verbindung zur Herkunft prägen Royal Spices.
          </p>
          <p><a class="link" href="/herkunft-qualitaet/">Entdecke unsere Geschichte <Arrow /></a></p>
          {/* O5: Live-Markenzeichen royal-spices-atelier-logo-square.png erst nach Freigabe; bis dahin das V1-Zeichen vom Etikett */}
          <Sprig class="story__mark" />
        </div>
        <figure class="story__photo figure">
          <Picture
            name="jars-photo"
            alt="Reihen abgefüllter Royal-Spices-Gläser mit Korken, grauem Siegelstreifen und Etikett auf einem Tisch."
            sizes="(min-width: 64rem) 40vw, 92vw"
          />
          <figcaption>Abbildung zeigt die 0,5-g-Ausführung.</figcaption>
        </figure>
      </div>
    </section>

    {/* S5 */}
    <HomeCollection />

    {/* S6 + S7 */}
    <section class="section band-deep roots" id="wurzeln" aria-labelledby="wurzeln-title">
      <div class="wrap grid">
        <figure class="roots__figure figure">
          <Picture
            name="saffron"
            alt="Getrocknete Safranfäden auf hellem Papier: dunkelrot, unregelmäßig gedreht, mit verbreiterten Enden."
            sizes="(min-width: 64rem) 50vw, 92vw"
          />
          <figcaption class="roots__caption">HERAT · 34°20' N</figcaption>
        </figure>
        <div class="roots__copy opener">
          <p class="eyebrow">DIE GESCHICHTE HINTER JEDEM FADEN</p>
          <h2 class="display-l" id="wurzeln-title">Unsere Wurzeln.<br />Dein Genuss.</h2>
          <p class="lead">
            In der Region Herat hat Safran Tradition. Hier beginnt unsere Geschichte – mit Sorgfalt, Handarbeit und dem Respekt vor einer außergewöhnlichen Zutat.
          </p>
          <p>Wir bringen den Charakter dieser Herkunft in deine Küche. Für Risotto, Reisgerichte, Desserts und die ganz besonderen Augenblicke.</p>
          <p><a class="link" href="/herkunft-qualitaet/">Mehr über Herkunft &amp; Qualität <Arrow /></a></p>
        </div>
      </div>
    </section>

    {/* S8 */}
    <section class="section ritual" id="ritual" aria-labelledby="ritual-title">
      <div class="wrap">
        <div class="opener">
          <p class="eyebrow">DAS SAFRAN-RITUAL</p>
          <h2 class="display-l" id="ritual-title">Entfalte das Aroma.</h2>
        </div>
        <ol class="ritual__steps">
          {
            ritual.map((r) => (
              <li>
                <span class="ritual__no" aria-hidden="true">{r.no}</span>
                <h3 class="display-s">{r.title}</h3>
                <p>{r.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    {/* S9 */}
    <section class="section band-slate business" id="business" aria-labelledby="business-title">
      <div class="wrap">
        <div class="business__head opener">
          <p class="eyebrow">ROYAL SPICES BUSINESS</p>
          <h2 class="display-l" id="business-title">Für Küchen, die<br />mehr erwarten.</h2>
          <p class="lead">Safran für Gastronomie und Handel. Exklusive kulinarische Erlebnisse und Catering für Unternehmen und Veranstaltungen.</p>
        </div>
        <div class="actions">
          <a class="btn" href="/b2b/">B2B kennenlernen <Arrow /></a>
          <a class="link" href="/catering/">Catering entdecken</a>
        </div>
      </div>
    </section>

    {/* V1: trade formats (facts PRODUCT-TRUTH Nr. 43/44, missing on Live) */}
    <section class="section trade" id="handel" aria-labelledby="handel-title">
      <div class="wrap grid">
        <div class="trade__head opener">
          <p class="eyebrow">Handel &amp; Gastronomie</p>
          <h2 class="display-l" id="handel-title">Vom Glas bis zur Kiste.</h2>
          <p class="lead">Für Küchen und Bars, für Feinkost und Einzelhandel, für Großhandel und Import. Drei Gebinde, ein Ansprechpartner.</p>
        </div>
        <ul class="trade__formats">
          {
            formats.map((f) => (
              <li>
                <p class="eyebrow">{f.spec}</p>
                <h3 class="display-m">{f.title}</h3>
                <p class="small">{f.audience}</p>
              </li>
            ))
          }
        </ul>
        <div class="trade__actions actions">
          <a class="btn" href="/kontakt/?anliegen=handel#anfrage">Handelsanfrage senden <Arrow /></a>
        </div>
      </div>
    </section>

    {/* V1: catering kitchen with the saffron dishes of the catalogue (PRODUCT-TRUTH Nr. 46) */}
    <section class="section band-deep kitchen" id="kueche" aria-labelledby="kueche-title">
      <div class="wrap grid">
        <div class="kitchen__head opener">
          <p class="eyebrow">Catering · Hamburg</p>
          <h2 class="display-l" id="kueche-title">Wir kochen auch damit.</h2>
          <p class="lead">Royal Spices ist Safranhandel und Küche zugleich. {site.owner} plant und kocht als Inhaber für Empfänge, Firmenveranstaltungen und private Anlässe.</p>
          <p><a class="link" href="/catering/">Catering ansehen <Arrow /></a></p>
        </div>
        <div class="kitchen__dishes">
          <p class="eyebrow">Safran in unserem Katalog</p>
          <ul>
            {
              saffronDishes.map((d) => (
                <li>
                  <span class="display-s">{d.name}</span>
                  <span class="small">{d.detail}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    {/* S10 */}
    <div class="lastline">
      <p class="wrap">ROYAL SPICES — FROM HERAT WITH CHARACTER — THE ART OF SAFFRON</p>
    </div>
  </div>
</Base>

<style>
  .home > [id] {
    scroll-margin-top: var(--header-h);
  }

  /* ---------------------------------------------------------------- S2 ticker */
  .ticker {
    padding-block: var(--s-4);
  }

  .ticker__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s-2) var(--s-6);
    margin: 0 auto;
    list-style: none;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .ticker__list span {
    color: #c9bd9c;
  }

  /* ---------------------------------------------------------------- S3 why */
  .why__head {
    max-width: 40rem;
  }

  .why__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s-6) clamp(1rem, 2.4vw, 2.5rem);
    margin: var(--s-7) 0 0;
    padding: 0;
    list-style: none;
  }

  .why__grid li {
    display: grid;
    gap: var(--s-3);
    align-content: start;
    padding-top: var(--s-5);
    border-top: 1px solid var(--rule-strong);
  }

  .why__grid p {
    color: var(--ink-2);
  }

  .why__sign {
    font-size: 1.25rem;
    line-height: 1;
    color: var(--saffron);
  }

  /* ---------------------------------------------------------------- S4 story */
  .story__copy {
    grid-column: 1 / span 6;
    align-content: center;
  }

  .story :global(.story__mark) {
    width: 3.5rem;
    height: auto;
    color: var(--bronze);
  }

  .story__photo {
    grid-column: 8 / span 5;
  }

  .story__photo :global(img) {
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 78%;
  }

  /* ---------------------------------------------------------------- S6 + S7 roots */
  .roots__figure {
    grid-column: 1 / span 6;
    position: relative;
  }

  .roots__figure :global(img) {
    aspect-ratio: 5 / 4;
    object-fit: cover;
  }

  .roots__caption {
    position: absolute;
    left: var(--s-4);
    bottom: var(--s-4);
    margin: 0;
    padding: 0.375rem 0.625rem;
    background: var(--paper-soft);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--ink);
  }

  .roots__copy {
    grid-column: 8 / span 5;
    align-content: center;
  }

  .roots__copy p:not(.eyebrow):not(.lead) {
    color: var(--ink-2);
  }

  /* ---------------------------------------------------------------- S8 ritual */
  .ritual__steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-6) clamp(1rem, 2.4vw, 2.5rem);
    margin: var(--s-7) 0 0;
    padding: 0;
    list-style: none;
  }

  .ritual__steps li {
    display: grid;
    gap: var(--s-3);
    align-content: start;
    padding-top: var(--s-5);
    border-top: 1px solid var(--rule-strong);
  }

  .ritual__no {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--bronze);
  }

  .ritual__steps p {
    color: var(--ink-2);
  }

  /* ---------------------------------------------------------------- S9 business */
  .business__head {
    max-width: 44rem;
  }

  .business .actions {
    margin-top: var(--s-6);
  }

  /* ---------------------------------------------------------------- V1 trade */
  .trade__head {
    grid-column: 1 / span 7;
  }

  .trade__formats {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0 clamp(1rem, 2.4vw, 2.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .trade__formats li {
    padding-top: var(--s-5);
    border-top: 1px solid var(--rule-strong);
    display: grid;
    gap: var(--s-3);
    align-content: start;
  }

  .trade__actions {
    grid-column: 1 / -1;
  }

  /* ---------------------------------------------------------------- V1 kitchen */
  .kitchen__head {
    grid-column: 1 / span 6;
    align-content: start;
  }

  .kitchen__dishes {
    grid-column: 8 / span 5;
  }

  .kitchen__dishes ul {
    margin: var(--s-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .kitchen__dishes li {
    display: grid;
    gap: 0.125rem;
    padding-block: var(--s-4);
    border-top: 1px solid var(--rule);
  }

  .kitchen__dishes li:last-child {
    border-bottom: 1px solid var(--rule);
  }

  /* ---------------------------------------------------------------- S10 last line */
  .lastline {
    padding-block: var(--s-6);
    border-top: 1px solid var(--rule);
  }

  .lastline p {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-align: center;
    color: var(--bronze);
  }

  /* ---------------------------------------------------------------- responsive composition */
  @media (max-width: 63.99rem) {
    .why__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .story__copy,
    .story__photo,
    .roots__figure,
    .roots__copy,
    .trade__head,
    .kitchen__head,
    .kitchen__dishes {
      grid-column: 1 / -1;
    }

    .ritual__steps,
    .trade__formats {
      grid-template-columns: 1fr;
      gap: var(--s-5);
    }
  }

  @media (max-width: 35.99rem) {
    .why__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
