---
// Product list = the live collection "Safran" (/collections/safran). Products come from the catalog:
// with a store from the Storefront API at build time, without one from the handles in product.ts.
// Live filter and sort controls are left out (two products). Below the list the V1 trade formats.
import Base from '@/layouts/Base.astro';
import ProductCard from '@/components/product/ProductCard.astro';
import LargerQuantities from '@/components/product/LargerQuantities.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { getCatalog } from '@/lib/commerce/catalog';

const catalog = await getCatalog();
const count = `${catalog.length} ${catalog.length === 1 ? 'Produkt' : 'Produkte'}`;
---

<Base
  title="Herat Negin Safran"
  description="Ganze Negin-Safranfäden aus Herat in Afghanistan – für feine Reisgerichte, Saucen und Desserts. Erhältlich in ausgewählten Glasgrößen."
>
  <section class="page-head">
    <div class="wrap opener">
      <Breadcrumbs
        items={[
          { name: 'Start', path: '/' },
          { name: 'Safran', path: '/produkte/' },
        ]}
      />
      <h1 class="display-xl"><span class="sr-only">Kategorie: </span>Herat Negin Safran</h1>
      <div class="collection__intro">
        <h2 class="display-m">Royal Spices – Safran aus Herat</h2>
        <p class="lead">Entdecke ganze Negin-Safranfäden aus Herat in Afghanistan. Sorgfältig ausgewählt für feine Reisgerichte, Saucen, Desserts und besondere Genussmomente. Erhältlich in ausgewählten Glasgrößen.</p>
      </div>
    </div>
  </section>

  <section class="section--tight collection" aria-labelledby="liste-title">
    <div class="wrap">
      <h2 class="eyebrow collection__count" id="liste-title">{count}</h2>
      <ul class="collection__grid" role="list">
        {
          catalog.map((product, i) => (
            <li>
              <ProductCard product={product} loading={i < 2 ? 'eager' : 'lazy'} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* V1: trade formats that lead to the inquiry (V1/Live rule; the live collection has only the jars) */}
  <LargerQuantities />
</Base>

<style>
  .collection__intro {
    display: grid;
    gap: var(--s-3);
  }

  .collection {
    padding-bottom: var(--section-pad);
  }

  .collection__count {
    margin-bottom: var(--s-5);
  }

  .collection__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-7) clamp(1rem, 2.4vw, 2.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 47.99rem) {
    .collection__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
