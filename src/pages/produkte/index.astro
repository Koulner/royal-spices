---
// Product list = the live collection "Safran" (/collections/safran). Products come from the catalog:
// with a store from the Storefront API at build time, without one from the handles in product.ts.
// Live filter and sort controls are left out (two products). Below the list the V1 trade formats.
// Kapitel Glas (Redesign T-20261103-03): the first product dominates as a lit picture in a gold frame,
// the others rank below it as rows, no equal cards.
import Base from '@/layouts/Base.astro';
import ProductCard from '@/components/product/ProductCard.astro';
import LargerQuantities from '@/components/product/LargerQuantities.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import RedThread from '@/components/RedThread.astro';
import { getCatalog } from '@/lib/commerce/catalog';

const catalog = await getCatalog();
// Das größte Glas steht vorn (heute 1 g), auch wenn der Katalog anders sortiert ist.
const products = [...catalog].sort((a, b) => (b.facts?.netGrams ?? 0) - (a.facts?.netGrams ?? 0));
const count = `${catalog.length} ${catalog.length === 1 ? 'Produkt' : 'Produkte'}`;
---

<Base
  title="Herat Negin Safran"
  headerWorld="nacht"
  description="Ganze Negin-Safranfäden aus Herat in Afghanistan – für feine Reisgerichte, Saucen und Desserts. Erhältlich in ausgewählten Glasgrößen."
>
  <section class="regal world-nacht zone" aria-labelledby="regal-title" data-world="nacht">
    <RedThread
      class="thread--glut"
      glow
      d="M97.5 0C97.9 14 97.1 30 97.5 46S97.9 82 97.5 100"
      m="M96.8 0C97.2 30 96.4 60 96.8 100"
    />
    <div class="wrap">
      <div class="kopf kopf--seite">
        <Breadcrumbs
          items={[
            { name: 'Start', path: '/' },
            { name: 'Safran', path: '/produkte/' },
          ]}
        />
        <p class="kapitel">Glas</p>
      </div>
      <h1 class="chapter chapter--akzent regal__title" id="regal-title"><span class="sr-only">Kategorie: </span>Herat Negin <em>Safran</em></h1>

      <div class="regal__grid">
        <div class="regal__intro">
          <h2 class="display-m">Royal Spices – Safran aus Herat</h2>
          <p class="lead">Entdecke ganze Negin-Safranfäden aus Herat in Afghanistan. Sorgfältig ausgewählt für feine Reisgerichte, Saucen, Desserts und besondere Genussmomente. Erhältlich in ausgewählten Glasgrößen.</p>
          <h2 class="eyebrow regal__count" id="liste-title">{count}</h2>
        </div>
        <ul class="regal__liste" role="list" aria-labelledby="liste-title">
          {
            products.map((product, i) => (
              <li>
                <ProductCard
                  product={product}
                  large={i === 0}
                  sizes={i === 0 ? '(min-width: 64rem) 52vw, 100vw' : '(min-width: 48rem) 8.25rem, 6.5rem'}
                  loading={i < 2 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : undefined}
                />
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  {/* V1: trade formats that lead to the inquiry (V1/Live rule; the live collection has only the jars) */}
  <LargerQuantities />
</Base>

<style>
  .regal {
    padding-bottom: clamp(5rem, 9vw, 9rem);
  }

  .regal__title {
    margin-top: clamp(1.5rem, 3vw, 3rem);
  }

  .regal__title em {
    display: inline-block;
    margin-left: 0.34em;
  }

  /* Rechts Einleitung und Zeilen, links das erste Produkt über alle Zeilen. Die letzte Zeile nimmt den Rest auf. */
  .regal__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    grid-template-rows: repeat(5, auto) 1fr;
    column-gap: clamp(2.5rem, 6vw, 6rem);
    margin-top: clamp(3rem, 6vw, 6rem);
  }

  .regal__intro {
    grid-column: 2;
    grid-row: 1;
    display: grid;
    gap: var(--s-4);
    align-content: start;
    justify-items: start;
  }

  .regal__count {
    margin-top: var(--s-5);
    margin-bottom: var(--s-4);
  }

  .regal__liste {
    display: contents;
  }

  .regal__liste li {
    grid-column: 2;
  }

  .regal__liste li:first-child {
    grid-column: 1;
    grid-row: 1 / -1;
  }

  /* Zeilen: kleines Bild links, Titel und Preis rechts */
  .regal__liste li:not(:first-child) :global(.pcard) {
    grid-template-columns: 8.25rem minmax(0, 1fr);
    column-gap: 1.25rem;
    padding-block: var(--s-5);
    border-top: 1px solid var(--rule-strong);
  }

  .regal__liste li:not(:first-child) :global(.pcard > *) {
    grid-column: 2;
  }

  .regal__liste li:not(:first-child) :global(.pcard__media) {
    grid-column: 1;
    grid-row: 1 / span 6;
  }

  .regal__liste li:not(:first-child) :global(.pcard__media img) {
    aspect-ratio: 4 / 5;
    object-position: 50% 78%;
    border-radius: 0;
  }

  @media (max-width: 63.99rem) {
    .regal__grid {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      row-gap: var(--s-6);
    }

    .regal__intro,
    .regal__liste li,
    .regal__liste li:first-child {
      grid-column: 1;
      grid-row: auto;
    }

    .regal__count {
      margin-bottom: 0;
    }
  }

  @media (max-width: 47.99rem) {
    .regal__title em {
      margin-left: 0;
    }

    .regal__liste li:not(:first-child) :global(.pcard) {
      grid-template-columns: 6.5rem minmax(0, 1fr);
      column-gap: var(--s-4);
    }
  }
</style>
