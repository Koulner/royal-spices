---
import Picture from './Picture.astro';
import { site, footerExploreNav, footerInfoNav } from '@/config/site';
---

<footer class="site-footer band-slate">
  <div class="wrap site-footer__grid">
    <div class="site-footer__brand">
      {/* Logo von royalspices.de, freigestellt, Schrift hell für den dunklen Fuß */}
      <a class="site-footer__wordmark" href="/" aria-label="Royal Spices – Startseite">
        <Picture class="site-footer__logo" name="logo-wide-light" alt="" sizes="10.5rem" />
      </a>
      <p class="eyebrow site-footer__claim">THE ART OF SAFFRON</p>
      <p class="small">Edler Safran aus Herat. Genuss für besondere Momente.</p>
    </div>

    <nav class="site-footer__nav" aria-label="Entdecken">
      <p class="eyebrow">Entdecken</p>
      <ul>
        {footerExploreNav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <nav class="site-footer__nav" aria-label="Informationen">
      <p class="eyebrow">Informationen</p>
      <ul>
        {footerInfoNav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <address class="site-footer__contact">
      <p class="eyebrow">Kontaktiere uns</p>
      <p>
        {site.name}<br />
        {site.owner}<br />
        {site.address.street}<br />
        {site.address.postalCode}
        {site.address.city}<br />
        {site.address.countryName}
      </p>
      <p>
        <a href={site.phone.href}>{site.phone.display}</a><br />
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </address>

    {/* O4: the sign-up form follows once a newsletter service with double opt-in is connected. */}
    <section class="site-footer__journal" aria-label="The Royal Journal">
      <p class="eyebrow">THE ROYAL JOURNAL</p>
      <p class="site-footer__journal-title">Genuss beginnt mit Inspiration.</p>
      <p class="small">Safran-Rezepte und ausgewählte Neuigkeiten von Royal Spices.</p>
    </section>
  </div>

  <div class="wrap site-footer__base">
    <p class="small">© {new Date().getFullYear()} {site.name} · Alle Rechte vorbehalten</p>
    <p class="small site-footer__motto">HERAT · HAMBURG · THE ART OF SAFFRON</p>
  </div>
</footer>

<style>
  .site-footer {
    padding-top: clamp(3.5rem, 7vw, 6rem);
    padding-bottom: var(--s-6);
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr 1.1fr;
    gap: var(--s-7) clamp(1.5rem, 4vw, 4rem);
  }

  .site-footer__wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    text-decoration: none;
  }

  .site-footer__wordmark :global(.site-footer__logo img) {
    display: block;
    width: auto;
    height: 3.5rem;
  }

  .site-footer__claim {
    margin-top: var(--s-3);
  }

  .site-footer__brand .small {
    margin-top: var(--s-4);
    max-width: 22rem;
  }

  address {
    font-style: normal;
  }

  .site-footer__contact p + p,
  .site-footer__nav ul {
    margin-top: var(--s-4);
  }

  .site-footer__contact .eyebrow + p {
    margin-top: var(--s-4);
  }

  .site-footer ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__nav ul {
    display: grid;
    margin-top: var(--s-3);
  }

  .site-footer a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    text-decoration: none;
  }

  .site-footer a:hover {
    text-decoration: underline;
    text-decoration-color: #e0907f;
    text-underline-offset: 0.3em;
  }

  .site-footer__journal {
    grid-column: 1 / -1;
    padding-top: var(--s-6);
    border-top: 1px solid var(--rule);
  }

  .site-footer__journal-title {
    margin-top: var(--s-3);
    font-family: var(--font-display), Georgia, serif;
    font-size: clamp(1.375rem, 2.4vw, 1.75rem);
    font-weight: 500;
    line-height: 1.2;
  }

  .site-footer__journal .small {
    margin-top: var(--s-3);
  }

  .site-footer__base {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3) var(--s-6);
    margin-top: clamp(2.5rem, 6vw, 5rem);
    padding-top: var(--s-4);
    border-top: 1px solid var(--rule);
  }

  .site-footer__motto {
    letter-spacing: 0.14em;
  }

  @media (max-width: 55.99rem) {
    .site-footer__grid {
      grid-template-columns: 1fr 1fr;
    }

    .site-footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 35.99rem) {
    .site-footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
