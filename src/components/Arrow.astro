---
interface Props {
  dir?: 'right' | 'down';
}
const { dir = 'right' } = Astro.props;
---

<svg class="arrow" viewBox="0 0 16 16" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
  {dir === 'right' ? <path d="M2.5 8h11M9 3.5 13.5 8 9 12.5" /> : <path d="M8 2.5v11M3.5 9 8 13.5 12.5 9" />}
</svg>
