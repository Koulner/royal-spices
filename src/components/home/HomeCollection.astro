---
// Live S5 "Die Kollektion" als Kapitel Glas (Redesign T-20261103-02): theme text word for word,
// quality as on the label: Grade 1 (D3/D4). The 1-g jar dominates as a lit picture in a gold frame,
// 0,5 g and the gift box rank below it, no three equal cards.
// Prices and product images come only from the catalog (src/lib/commerce/catalog.ts, T-20261016-03).
// Without a store the catalog has no price: the price line is left out, the link to the product stays.
// Gift box (D7): not a Shopify product yet, so the card says "In Vorbereitung" and shows no price.
// As soon as the customer creates it in Shopify (handle or title containing "Geschenkbox"),
// the card shows the Shopify title, the catalog price and the link to its product page.
// A unit price (Grundpreis) appears under a price only when Shopify has one (unit-price.ts).
import Arrow from '@/components/Arrow.astro';
import Picture from '@/components/Picture.astro';
import RedThread from '@/components/RedThread.astro';
import { getCatalog, formatPrice, unitPriceLabel } from '@/lib/commerce/catalog';
import { HANDLES, productPath } from '@/config/handles.mjs';

const catalog = await getCatalog();
const find = (handle: string) => catalog.find((p) => p.handle === handle);
const gift = catalog.find((p) => /geschenkbox/i.test(`${p.handle} ${p.title}`));

const cards = [
  {
    href: productPath(HANDLES.oneGram),
    product: find(HANDLES.oneGram),
    badge: 'UNSER ORIGINAL',
    eyebrow: 'HERAT NEGIN · GRADE 1',
    title: 'Premium Safran – 1 g',
    text: 'Ganze, handverlesene Fäden.',
    imageAlt: 'Ganze Premium-Safranfäden aus Herat – 1-g-Produkt',
    still: 'live-jar-1g',
    stillAlt:
      'Royal-Spices-Glas 1 g mit Korken und dunklem Siegelstreifen, cremefarbenes Etikett „Royal Spices, Saffron, Herat Negin, Grade 1, 1 g, Packed in Germany“, ringsum getrocknete Safranfäden.',
  },
  {
    href: productPath(HANDLES.halfGram),
    product: find(HANDLES.halfGram),
    badge: 'KLASSIKER',
    eyebrow: 'HERAT NEGIN · GRADE 1',
    title: 'Premium Safran – 0,5 g',
    text: 'Das Original im kleinen Glas.',
    imageAlt: 'Royal Spices Safran im 0,5-g-Glas',
    still: 'jars-photo',
    stillAlt: 'Reihen abgefüllter Royal-Spices-Gläser mit Korken, grauem Siegelstreifen und Etikett auf einem Tisch.',
  },
];
const [first] = cards;
const SIZES_VITRINE = '(min-width: 64rem) 52vw, (min-width: 48rem) 58vw, 100vw';
const SIZES_SMALL = '(min-width: 48rem) 8.25rem, 6.5rem';
---

<section class="glas world-nacht" id="kollektion" aria-labelledby="kollektion-title" data-world="nacht">
  <RedThread
    class="thread--glut"
    glow
    d="M97.5 0C97.9 12 97.1 24 97.5 40C97.7 46 97.2 49 97.2 56C97.2 63 97.6 65 97.5 72S97.9 90 97.5 100"
    m="M96.8 0C97.2 30 96.4 60 96.8 100"
  />
  <div class="wrap">
    <div class="kopf">
      <p class="eyebrow">DIE KOLLEKTION</p>
      <p class="kapitel">Glas</p>
    </div>
    <h2 class="chapter" id="kollektion-title">Kleine Menge.<br /><em>Große Wirkung.</em></h2>

    <div class="glas__grid">
      {/* The picture has no alpha channel, so it stays light and becomes the lit surface of the dark chapter. */}
      <figure class="vitrine" data-vitrine>
        {
          first.product?.image ? (
            <img
              src={first.product.image.url}
              alt={first.product.image.altText ?? first.imageAlt}
              width={first.product.image.width}
              height={first.product.image.height}
              loading="lazy"
              decoding="async"
            />
          ) : (
            <Picture name={first.still} alt={first.stillAlt} sizes={SIZES_VITRINE} />
          )
        }
      </figure>

      <div class="glas__liste">
        <p class="lead">Entdecke die Welt von Royal Spices – von der täglichen Genussküche bis zum besonderen Geschenk.</p>

        <ul class="collection__cards">
          {
            cards.map((c, i) => (
              <li class="card">
                {i > 0 && (
                  <div class="card__visual">
                    {c.product?.image ? (
                      <img
                        src={c.product.image.url}
                        alt={c.product.image.altText ?? c.imageAlt}
                        width={c.product.image.width}
                        height={c.product.image.height}
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <Picture name={c.still} alt={c.stillAlt} sizes={SIZES_SMALL} />
                    )}
                  </div>
                )}
                <div class="card__info">
                  <p class="eyebrow card__badge">{c.badge}</p>
                  <h3 class="card__title">{c.title}</h3>
                  <p class="eyebrow">{c.eyebrow}</p>
                  <p class="card__text">{c.text}</p>
                  {c.product?.price && (
                    <p class="card__price">
                      <span class="card__amount">{formatPrice(c.product.price)}</span>
                      <span class="small">inkl. MwSt.</span>
                    </p>
                  )}{c.product?.price && c.product.unitPrice && <p class="small">{unitPriceLabel(c.product.unitPrice)}</p>}
                  <a class:list={[i === 0 ? 'btn' : 'link']} href={c.href}>
                    Produkt ansehen <Arrow />
                  </a>
                </div>
              </li>
            ))
          }

          <li class="card card--gift">
            <div class="card__visual card__visual--gift">
              <div class="gift">
                <p class="gift__wordmark">ROYAL<br />SPICES</p>
                <p class="gift__line">THE SAFFRON COLLECTION</p>
              </div>
            </div>
            <div class="card__info">
              {!gift && <p class="eyebrow card__badge">COMING SOON</p>}
              {
                gift ? (
                  <>
                    <h3 class="card__title">{gift.title}</h3>
                    <p class="eyebrow">THE ROYAL GIFT</p>
                    {gift.price && (
                      <p class="card__price">
                        <span class="card__amount">{formatPrice(gift.price)}</span>
                        <span class="small">inkl. MwSt.</span>
                      </p>
                    )}{gift.price && gift.unitPrice && <p class="small">{unitPriceLabel(gift.unitPrice)}</p>}
                    <a class="link" href={`/produkte/${gift.handle}/`}>
                      Produkt ansehen <Arrow />
                    </a>
                  </>
                ) : (
                  <>
                    <h3 class="card__title">Safran Geschenkbox – 5 g</h3>
                    <p class="eyebrow">THE ROYAL GIFT</p>
                    <p class="card__text">Ein besonderes Geschenk in Vorbereitung.</p>
                    <p class="card__status">In Vorbereitung</p>
                  </>
                )
              }
            </div>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  /* overflow-x: clip, sonst läuft der Lichtaustritt der Vitrine auf dem Telefon quer über */
  .glas {
    position: relative;
    overflow-x: clip;
    padding-block: clamp(2rem, 4vw, 3.5rem) clamp(9rem, 16vw, 15rem);
  }

  .glas :global(.kopf .eyebrow),
  .glas :global(.kapitel),
  .glas :global(.chapter em) {
    color: var(--blatt);
  }

  .glas :global(.chapter em) {
    display: inline-block;
    margin-left: 0.34em;
  }

  .glas__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2.5rem, 5.5vw, 5.5rem);
    margin-top: clamp(3rem, 6vw, 6rem);
    align-items: start;
  }

  .vitrine {
    position: relative;
    grid-column: 2;
    grid-row: 1;
    isolation: isolate;
  }

  /* Lichtaustritt und Dimmer: --lit kommt aus dem Scrollen, ohne Bewegung steht das Licht ganz da */
  .vitrine::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -16% -14% -22%;
    background: radial-gradient(closest-side, rgb(236 196 132 / 0.26), rgb(236 196 132 / 0.09) 62%, transparent);
    opacity: var(--lit, 1);
    pointer-events: none;
  }

  .vitrine::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--nacht);
    opacity: calc((1 - var(--lit, 1)) * 0.82);
    pointer-events: none;
  }

  .vitrine img,
  .vitrine :global(img) {
    width: 100%;
    aspect-ratio: 8 / 9;
    object-fit: cover;
    object-position: 50% 60%;
    outline: 1px solid rgb(217 180 106 / 0.55);
    outline-offset: 0.625rem;
  }

  .glas__liste {
    grid-column: 1;
    grid-row: 1;
    display: grid;
    gap: clamp(2.5rem, 3.6vw, 3.5rem);
  }

  .collection__cards {
    display: grid;
  }

  /* 1 g: groß und ohne eigenes Bild, es steht in der Vitrine */
  .card:first-child {
    margin-bottom: clamp(2rem, 3vw, 3rem);
  }

  .card:first-child .card__title {
    font-size: clamp(2.5rem, 3.4vw, 3.0625rem);
    line-height: 1;
    letter-spacing: -0.012em;
    margin-bottom: var(--s-2);
  }

  .card:first-child .card__text {
    font-size: 1.0625rem;
    margin-top: var(--s-2);
    margin-bottom: var(--s-3);
  }

  .card:first-child .card__info {
    gap: var(--s-2);
  }

  .card:not(:first-child) {
    display: grid;
    grid-template-columns: 8.25rem minmax(0, 1fr);
    gap: 1.25rem;
    padding-block: var(--s-5);
    border-top: 1px solid var(--rule-strong);
  }

  .card__visual {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #1a1612;
  }

  .card__visual img,
  .card__visual :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 78%;
  }

  .card__info {
    display: grid;
    gap: var(--s-1);
    align-content: start;
    justify-items: start;
  }

  .card__badge {
    color: var(--blatt);
  }

  .card__title {
    font-family: var(--font-display), Georgia, serif;
    font-weight: 500;
    font-size: 1.75rem;
    line-height: 1.1;
  }

  .card__text {
    font-size: 0.9375rem;
    margin-top: var(--s-1);
  }

  .card__price {
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
    margin-top: var(--s-1);
  }

  .card__amount {
    font-size: 1.25rem;
    font-weight: 600;
  }

  .card:first-child .card__amount {
    font-size: 1.5rem;
  }

  .card__status {
    margin-top: var(--s-2);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--kerze-2);
  }

  /* the gift box is drawn in CSS: no picture of it exists yet */
  .card__visual--gift {
    display: grid;
    place-items: center;
  }

  .gift {
    display: grid;
    gap: var(--s-2);
    place-content: center;
    width: 86%;
    aspect-ratio: 1;
    padding: var(--s-1);
    background: #7c1a13;
    box-shadow: inset 0 0 0 1px rgb(179 141 98 / 0.7);
    text-align: center;
    color: #e4cf9e;
  }

  .gift__wordmark {
    font-family: var(--font-display), Georgia, serif;
    font-size: 1.0625rem;
    line-height: 1.05;
    letter-spacing: 0.1em;
  }

  .gift__line {
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: 0.02em;
  }

  /* Tablet: Die Vitrine steht oben, 0,5 g und Geschenkbox nebeneinander darunter */
  @media (max-width: 63.99rem) {
    .glas__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .vitrine {
      grid-column: 1;
      grid-row: 1;
      width: min(100%, 36rem);
      justify-self: center;
    }

    .glas__liste {
      grid-column: 1;
      grid-row: 2;
    }

    .collection__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: clamp(1rem, 2.4vw, 2.5rem);
    }

    .card:first-child {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 47.99rem) {
    .glas :global(.chapter em) {
      margin-left: 0;
    }

    .glas__grid {
      margin-top: 2.5rem;
    }

    .vitrine {
      width: auto;
      justify-self: stretch;
      margin-inline: calc(var(--gutter) * -1);
    }

    .vitrine img,
    .vitrine :global(img) {
      aspect-ratio: 1;
      object-position: 50% 50%;
      outline: 0;
    }

    .collection__cards {
      grid-template-columns: minmax(0, 1fr);
    }

    .card:not(:first-child) {
      grid-template-columns: 6.5rem minmax(0, 1fr);
      gap: var(--s-4);
    }

    .card:first-child .card__title {
      font-size: 10.4vw;
    }

    .gift {
      width: 100%;
      height: 100%;
      aspect-ratio: auto;
    }

    .gift__wordmark {
      font-size: 0.875rem;
    }
  }
</style>
