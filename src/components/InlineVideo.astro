---
// Inline video from the generated manifest ("npm run assets:video" -> src/data/videos.json).
// The frame is an SVG placeholder in the flow with the film's own size (no style attribute: the CSP
// forbids it); poster and video lie on top. Without JS the native controls work with the <source>
// list (AV1 before H.264, nothing loads before play) and the poster comes from <noscript>. With JS
// src/scripts/inline-video.ts places the poster from its <template> and picks one encoding, both near
// the viewport (before the first scroll only in view), and plays it once, muted, with its own buttons.
import videos from '@/data/videos.json';
import Picture from '@/components/Picture.astro';

type Source = { src: string; type: string; codec: string; width: number; height: number; bytes: number };
type Film = { width: number; height: number; duration: number; fps: number; poster: string; sources: Source[] };

interface Props {
  name: string;
  /** text alternative: what the film shows */
  label: string;
  class?: string;
}

const { name, label, class: className } = Astro.props;
const film = (videos as Record<string, Film>)[name];
if (!film) throw new Error(`InlineVideo: no video named "${name}". Run "npm run assets:video".`);
const sources = film.sources.toSorted((a, b) => (a.codec === b.codec ? b.width - a.width : a.codec === 'av1' ? -1 : 1));
---

<figure class:list={['ivideo', className]} data-ivideo data-duration={film.duration} data-fps={film.fps}>
  <svg class="ivideo__frame" width={film.width} height={film.height} viewBox={`0 0 ${film.width} ${film.height}`} aria-hidden="true" focusable="false"></svg>
  <template><Picture class="ivideo__poster" name={film.poster} alt="" sizes="(max-width: 30rem) 100vw, 420px" loading="lazy" /></template>
  <noscript><Picture class="ivideo__poster" name={film.poster} alt="" sizes="(max-width: 30rem) 100vw, 420px" loading="lazy" /></noscript>
  <video class="ivideo__video" playsinline muted preload="none" controls aria-label={label}>
    {sources.map((s) => <source src={s.src} type={s.type} data-codec={s.codec} data-width={s.width} data-height={s.height} data-bytes={s.bytes} />)}
  </video>
  <div class="ivideo__bar" hidden>
    <button class="ivideo__btn" type="button" data-act="play" aria-label="Abspielen">
      <svg class="i i--off" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg>
      <svg class="i i--on" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z"></path></svg>
    </button>
    <button class="ivideo__btn" type="button" data-act="again" hidden>
      <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5V2L7 6.5 12 11V7.5a5.5 5.5 0 1 1-5.5 5.5H4a8 8 0 1 0 8-8z"></path></svg>
      <span>Noch einmal</span>
    </button>
    <button class="ivideo__btn" type="button" data-act="sound">
      <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9z"></path><path class="i--on" d="M15.5 8.5a5 5 0 0 1 0 7M18 6a8.5 8.5 0 0 1 0 12" fill="none" stroke="currentColor" stroke-width="2"></path><path class="i--off" d="M16 9.5l5 5m0-5l-5 5" fill="none" stroke="currentColor" stroke-width="2"></path></svg>
      <span>Ton an</span>
    </button>
  </div>
</figure>

<script>
  import '@/scripts/inline-video';
</script>

<style>
  .ivideo {
    position: relative;
    width: fit-content;
    max-width: min(420px, 100%);
    margin: 0;
    overflow: hidden;
    border-radius: 0.5rem;
    background: var(--slate-2);
  }

  /* the placeholder holds the film's aspect ratio in the flow */
  .ivideo__frame {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 85svh;
  }

  .ivideo :global(.ivideo__poster),
  .ivideo__video,
  .ivideo :global(.ivideo__poster img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .ivideo :global(.ivideo__poster img),
  .ivideo__video {
    display: block;
    object-fit: cover;
  }

  /* with JS the video stays invisible until it has a frame; the poster shows meanwhile */
  .ivideo[data-js]:not([data-ready]) .ivideo__video {
    opacity: 0;
  }

  .ivideo [hidden] {
    display: none;
  }

  .ivideo__bar {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    padding: var(--s-3);
    background: linear-gradient(to top, rgb(0 0 0 / 0.5), transparent);
  }

  .ivideo__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--s-2);
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0 var(--s-3);
    border: 1px solid rgb(255 255 255 / 0.55);
    border-radius: 999px;
    background: rgb(20 18 15 / 0.62);
    color: #fff;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1;
    cursor: pointer;
  }

  .ivideo__btn:hover {
    background: rgb(20 18 15 / 0.88);
  }

  .ivideo__btn:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
    box-shadow: 0 0 0 5px var(--ink);
  }

  .ivideo__btn[data-act='play'] {
    padding: 0;
  }

  .i {
    width: 1.25rem;
    height: 1.25rem;
    fill: currentColor;
    flex: none;
  }

  .ivideo__btn[data-on] .i--off,
  .ivideo__btn:not([data-on]) .i--on {
    display: none;
  }
</style>
