---
// Responsive picture from the generated stills manifest (pipeline/images/build-stills.mjs).
import stills from '@/data/stills.json';

type Variant = { src: string; width: number; bytes: number };
type Still = { width: number; height: number; avif: Variant[]; webp: Variant[] };

interface Props {
  name: string;
  alt: string;
  sizes: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
}

const { name, alt, sizes, loading = 'lazy', fetchpriority, class: className } = Astro.props;
const still = (stills as Record<string, Still>)[name];
if (!still) throw new Error(`Picture: no still named "${name}". Run "npm run assets:stills".`);

const srcset = (list: Variant[]) => list.map((v) => `${v.src} ${v.width}w`).join(', ');
const fallback = still.webp[Math.min(1, still.webp.length - 1)];
---

<picture class={className}>
  <source type="image/avif" srcset={srcset(still.avif)} sizes={sizes} />
  <source type="image/webp" srcset={srcset(still.webp)} sizes={sizes} />
  <img
    src={fallback.src}
    width={still.width}
    height={still.height}
    alt={alt}
    loading={loading}
    decoding="async"
    fetchpriority={fetchpriority}
  />
</picture>
