---
// One product in the list /produkte/ (live collection card): image, title, price and unit price from Shopify.
// `large`: the first product of the list, a lit picture in a gold frame (Kapitel Glas, T-20261103-03).
import ProductImage from './ProductImage.astro';
import { formatPrice, unitPriceLabel, type CatalogProduct } from '@/lib/commerce/catalog';

interface Props {
  product: CatalogProduct;
  sizes: string;
  large?: boolean;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
}
const { product, sizes, large = false, loading = 'lazy', fetchpriority } = Astro.props;
const href = `/produkte/${product.handle}/`;
---

<article class="pcard">
  <div class:list={['pcard__media figure', { lichtbild: large }]}>
    <ProductImage product={product} sizes={sizes} loading={loading} fetchpriority={fetchpriority} />
  </div>
  <h3 class:list={[large ? 'display-l pcard__title pcard__title--large' : 'display-s pcard__title']}><a href={href}>{product.title}</a></h3>
  {
    product.price && (
      <p class="pcard__price">
        <span class="sr-only">Normaler Preis</span> {formatPrice(product.price)}
      </p>
    )
  }{product.price && product.unitPrice && <p class="small">{unitPriceLabel(product.unitPrice)}</p>}
  {product.available === false && <p class="small">Ausverkauft</p>}
</article>

<style>
  .pcard {
    position: relative;
    display: grid;
    gap: var(--s-2);
    align-content: start;
  }

  .pcard__media :global(img) {
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  .pcard__media.lichtbild {
    margin-bottom: var(--s-5);
  }

  .pcard__title--large {
    max-width: 18em;
  }

  /* the title link covers the whole card: one link, one tab stop */
  .pcard__title a {
    text-decoration: none;
  }

  .pcard__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .pcard__title a:hover,
  .pcard__title a:focus-visible {
    text-decoration: underline;
  }

  .pcard__price {
    font-weight: 600;
  }

  @media (max-width: 47.99rem) {
    .pcard__media.lichtbild {
      margin-inline: calc(var(--gutter) * -1);
      margin-bottom: var(--s-3);
    }
  }
</style>
