---
// Product description, word for word as in Shopify (only Grade A -> Grade 1, see catalog.ts).
//   Shopify text = product.ts text -> rendered with the structure from product.ts (headings, rows, breaks)
//   otherwise (text changed in Shopify, product unknown to product.ts) -> the blocks read from the
//   Shopify editor HTML (rich-text.ts) in the same look: h2 with a lead, h3 sections, rows
// Everything is text: Astro escapes it, nothing from Shopify is ever rendered as HTML.
// Redesign T-20261103-03: headline over the full width, the sections as label lines beside the lead.
import { structuredDescription, type CatalogProduct } from '@/lib/commerce/catalog';
import { groupByHeading } from '@/lib/commerce/rich-text';
import DescriptionInline from './DescriptionInline.astro';

interface Props {
  product: CatalogProduct;
}
const { product } = Astro.props;
const facts = structuredDescription(product);
const groups = facts ? [] : groupByHeading(product.body);
const lines = (text: string) => text.split('\n');
---

<div class="pdesc">
  {
    facts ? (
      <>
        <h2 class="pdesc__title">{facts.intro.heading}</h2>
        <p class="lead">{facts.intro.text}</p>
        {facts.sections.map((section) => (
          <section class="pdesc__section">
            <h3 class="display-s">{section.heading}</h3>
            {section.rows && (
              <ul class="pdesc__rows">
                {section.rows.map((row) => (
                  <li>
                    <strong>{row.label}:</strong> {row.value}
                  </li>
                ))}
              </ul>
            )}
            {section.paragraphs?.map((paragraph) => (
              <p>{lines(paragraph).map((line, i) => (i === 0 ? line : [<br />, line]))}</p>
            ))}
          </section>
        ))}
      </>
    ) : (
      groups.map(({ heading, blocks }) => {
        const content = blocks.map((block, i) =>
          block.kind === 'paragraph' ? (
            <p class={heading?.level === 2 && i === 0 ? 'lead' : undefined}>
              <DescriptionInline inline={block.inline} />
            </p>
          ) : block.kind === 'list' && block.ordered ? (
            <ol>
              {block.items.map((item) => (
                <li>
                  <DescriptionInline inline={item} />
                </li>
              ))}
            </ol>
          ) : block.kind === 'list' ? (
            <ul class="pdesc__rows">
              {block.items.map((item) => (
                <li>
                  <DescriptionInline inline={item} />
                </li>
              ))}
            </ul>
          ) : null,
        );
        return heading?.level === 3 ? (
          <section class="pdesc__section">
            <h3 class="display-s">
              <DescriptionInline inline={heading.inline} />
            </h3>
            {content}
          </section>
        ) : (
          <>
            {heading && (
              <h2 class="pdesc__title">
                <DescriptionInline inline={heading.inline} />
              </h2>
            )}
            {content}
          </>
        );
      })
    )
  }
</div>

<style>
  /* Links die Einleitung, rechts die Abschnitte. Die Einleitung läuft über die Abschnittszeilen. */
  .pdesc {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    column-gap: clamp(2.5rem, 7vw, 7rem);
    row-gap: var(--s-6);
    align-items: start;
  }

  .pdesc > :not(.pdesc__section, .pdesc__title) {
    grid-column: 1;
  }

  .pdesc > :global(.lead) {
    grid-row: 2 / span 8;
    position: sticky;
    top: calc(var(--header-h) + var(--s-5));
  }

  .pdesc__title {
    grid-column: 1 / -1;
    font-family: var(--font-display), Georgia, serif;
    font-weight: 500;
    font-size: clamp(2.75rem, 6.6vw, 6.25rem);
    line-height: 0.98;
    letter-spacing: -0.018em;
    max-width: 15em;
  }

  .pdesc__section {
    grid-column: 2;
    display: grid;
    gap: var(--s-3);
  }

  .pdesc__section p {
    max-width: var(--measure);
    color: var(--ink-2);
  }

  /* the live list "Produkt: …" (Shopify <ul><li><strong>) as lines of the label */
  .pdesc__rows {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pdesc__rows li {
    padding-block: 0.6875rem;
    padding-left: 10rem;
    text-indent: -10rem;
    border-top: 1px solid var(--rule);
  }

  .pdesc__rows li:last-child {
    border-bottom: 1px solid var(--rule);
  }

  /* :global, as the strong of the Shopify blocks comes from DescriptionInline */
  .pdesc__rows :global(strong) {
    display: inline-block;
    width: 10rem;
    text-indent: 0;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--ink-2);
  }

  @media (max-width: 63.99rem) {
    .pdesc {
      grid-template-columns: minmax(0, 1fr);
    }

    .pdesc > :global(.lead) {
      grid-row: auto;
      position: static;
    }

    .pdesc__section {
      grid-column: 1;
    }
  }

  @media (max-width: 47.99rem) {
    .pdesc__rows li {
      padding-left: 0;
      text-indent: 0;
    }

    .pdesc__rows :global(strong) {
      display: block;
      width: auto;
    }
  }
</style>
