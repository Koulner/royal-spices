---
// Product description, word for word as in Shopify (only Grade A -> Grade 1, see catalog.ts).
//   Shopify text = product.ts text -> rendered with the structure from product.ts (headings, rows, breaks)
//   otherwise (text changed in Shopify, product unknown to product.ts) -> the blocks read from the
//   Shopify editor HTML (rich-text.ts) in the same look: h2 with a lead, h3 sections, rows
// Everything is text: Astro escapes it, nothing from Shopify is ever rendered as HTML.
import { structuredDescription, type CatalogProduct } from '@/lib/commerce/catalog';
import { groupByHeading } from '@/lib/commerce/rich-text';
import DescriptionInline from './DescriptionInline.astro';

interface Props {
  product: CatalogProduct;
}
const { product } = Astro.props;
const facts = structuredDescription(product);
const groups = facts ? [] : groupByHeading(product.body);
const lines = (text: string) => text.split('\n');
---

<div class="pdesc prose">
  {
    facts ? (
      <>
        <h2 class="display-l">{facts.intro.heading}</h2>
        <p class="lead">{facts.intro.text}</p>
        {facts.sections.map((section) => (
          <section class="pdesc__section">
            <h3 class="display-s">{section.heading}</h3>
            {section.rows && (
              <ul class="pdesc__rows">
                {section.rows.map((row) => (
                  <li>
                    <strong>{row.label}:</strong> {row.value}
                  </li>
                ))}
              </ul>
            )}
            {section.paragraphs?.map((paragraph) => (
              <p>{lines(paragraph).map((line, i) => (i === 0 ? line : [<br />, line]))}</p>
            ))}
          </section>
        ))}
      </>
    ) : (
      groups.map(({ heading, blocks }) => {
        const content = blocks.map((block, i) =>
          block.kind === 'paragraph' ? (
            <p class={heading?.level === 2 && i === 0 ? 'lead' : undefined}>
              <DescriptionInline inline={block.inline} />
            </p>
          ) : block.kind === 'list' && block.ordered ? (
            <ol>
              {block.items.map((item) => (
                <li>
                  <DescriptionInline inline={item} />
                </li>
              ))}
            </ol>
          ) : block.kind === 'list' ? (
            <ul class="pdesc__rows">
              {block.items.map((item) => (
                <li>
                  <DescriptionInline inline={item} />
                </li>
              ))}
            </ul>
          ) : null,
        );
        return heading?.level === 3 ? (
          <section class="pdesc__section">
            <h3 class="display-s">
              <DescriptionInline inline={heading.inline} />
            </h3>
            {content}
          </section>
        ) : (
          <>
            {heading && (
              <h2 class="display-l">
                <DescriptionInline inline={heading.inline} />
              </h2>
            )}
            {content}
          </>
        );
      })
    )
  }
</div>

<style>
  .pdesc {
    display: grid;
    gap: var(--s-5);
    max-width: 44rem;
  }

  .pdesc__section {
    display: grid;
    gap: var(--s-3);
  }

  /* the live list "Produkt: …" (Shopify <ul><li><strong>) */
  .pdesc__rows {
    display: grid;
    gap: var(--s-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* :global, as the strong of the Shopify blocks comes from DescriptionInline */
  .pdesc__rows :global(strong) {
    font-weight: 600;
  }
</style>
