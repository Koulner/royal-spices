---
// Product facts set like the jar's own label: wordmark, utility line, ruled rows,
// and the two lines that are filled in per batch.
import Sprig from './Sprig.astro';
import { saffronJar, labelFacts, batchFields } from '@/data/product';

interface Props {
  /** Show the per-batch lines (best before, lot) as on the back label. */
  batch?: boolean;
  headingLevel?: 'h2' | 'h3';
}
const { batch = true, headingLevel: Heading = 'h3' } = Astro.props;
---

<div class="label sheet">
  <div class="sheet__head">
    <Sprig class="sheet__sprig" />
    <p class="sheet__brand">Royal Spices</p>
    <p class="eyebrow">{saffronJar.grade}</p>
  </div>
  <div class="sheet__title">
    <Heading class="sheet__name">{saffronJar.name}</Heading>
    <p class="sheet__qty">{saffronJar.quantity}</p>
  </div>
  <dl class="facts">
    {
      labelFacts
        .filter((f) => !['Bezeichnung', 'Sorte', 'Füllmenge'].includes(f.label))
        .map((f) => (
          <div>
            <dt>{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))
    }
    {
      batch &&
        batchFields.map((f) => (
          <div>
            <dt>{f.label}</dt>
            <dd>
              <span class="blank">{f.note}</span>
            </dd>
          </div>
        ))
    }
  </dl>
</div>

<style>
  .sheet {
    padding: clamp(1.5rem, 3vw, 2.5rem);
  }

  .sheet__head {
    display: grid;
    justify-items: start;
    gap: 0.25rem;
  }

  .sheet__sprig {
    width: 1.75rem;
    height: 1.6rem;
    color: var(--bronze);
    margin-bottom: 0.375rem;
  }

  .sheet__brand {
    font-family: var(--font-display), Georgia, serif;
    font-weight: 500;
    font-size: clamp(1.75rem, 2.4vw, 2.375rem);
    line-height: 1;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--bronze);
  }

  .sheet__head .eyebrow {
    margin-top: 0.5rem;
  }

  .sheet__title {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-4);
    margin-top: var(--s-5);
    padding-top: var(--s-4);
    border-top: 1px solid var(--rule-strong);
  }

  .sheet__name,
  .sheet__qty {
    font-family: var(--font-text), sans-serif;
    font-size: clamp(1.125rem, 1.4vw, 1.375rem);
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    line-height: 1.2;
  }

  .sheet__qty {
    text-transform: none;
    white-space: nowrap;
  }

  .sheet .facts {
    margin-top: var(--s-4);
  }
</style>
