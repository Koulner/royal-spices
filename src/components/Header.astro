---
import Picture from './Picture.astro';
import { primaryNav, secondaryNav, announcement, shopifyAccountUrl } from '@/config/site';
import { commerceEnabled } from '@/lib/commerce/config';

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<header class="site-header" data-header>
  <div class="announcement">
    <p class="announcement__text wrap">{announcement}</p>
  </div>

  <div class="site-header__bar wrap">
    {/* Logo von royalspices.de, Hintergrund freigestellt (pipeline/images/build-stills.mjs) */}
    <a class="wordmark" href="/" aria-label="Royal Spices – Startseite">
      <Picture class="wordmark__logo" name="logo-wide" alt="" sizes="8.25rem" loading="eager" />
    </a>

    {
      commerceEnabled && (
        <button class="cart-button" type="button" data-cart-open data-commerce hidden aria-label="Warenkorb öffnen">
          Warenkorb <span data-cart-count>0</span>
        </button>
      )
    }

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-menu" data-menu-toggle>
      <span class="menu-toggle__label" data-menu-label>Menü</span>
      <span class="menu-toggle__icon" aria-hidden="true"><i></i><i></i></span>
    </button>

    <nav class="site-nav" id="site-menu" aria-label="Hauptnavigation" data-menu>
      <ul class="site-nav__primary">
        {
          primaryNav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <ul class="site-nav__secondary">
        {
          secondaryNav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <ul class="site-nav__account">
        <li>
          <a href={shopifyAccountUrl}>Einloggen</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  /* The header sits in the flow (sticky) so the announcement above the bar scrolls away and the bar
     stays. The negative bottom margin lets the page start under the bar, as with the former fixed
     header: pages keep their var(--header-h) offsets. */
  .site-header {
    --announce-h: 2rem;
    position: sticky;
    top: calc(-1 * var(--announce-h));
    z-index: 50;
    margin-bottom: calc(-1 * var(--header-h));
    color: var(--ink);
    transition:
      background-color 0.25s var(--ease-out),
      box-shadow 0.25s var(--ease-out);
  }

  /* Solid once content scrolls underneath. Over the hero it stays clear: the image carries it. */
  .site-header:global(.is-solid) {
    background: var(--paper);
    box-shadow: 0 1px 0 var(--rule);
  }

  .announcement {
    height: var(--announce-h);
    display: flex;
    align-items: center;
    overflow: hidden;
    background: var(--slate);
    color: var(--paper-soft);
  }

  .announcement__text {
    width: 100%;
    margin: 0;
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: 0.14em;
    text-align: center;
    text-wrap: balance;
  }

  .site-header__bar {
    max-width: none;
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-5);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 2.75rem;
    text-decoration: none;
    color: var(--ink);
  }

  .wordmark :global(.wordmark__logo img) {
    display: block;
    width: auto;
    height: 2.75rem;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 2.6vw, 2.75rem);
  }

  .site-nav ul {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 1.9vw, 2rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    text-decoration: none;
    white-space: nowrap;
    background: linear-gradient(var(--saffron), var(--saffron)) no-repeat 0 calc(50% + 0.85em) / 0 1px;
    transition: background-size 0.22s var(--ease-out);
  }

  .site-nav a:hover,
  .site-nav a[aria-current='page'] {
    background-size: 100% 1px;
  }

  .site-nav__secondary,
  .site-nav__account {
    padding-left: clamp(1.25rem, 2.6vw, 2.75rem) !important;
    border-left: 1px solid var(--rule-strong);
  }

  .menu-toggle {
    display: none;
  }

  .cart-button {
    order: 3;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0 0.25rem;
    border: 0;
    background: none;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    position: relative;
    z-index: 2;
  }

  .cart-button[hidden] {
    display: none;
  }

  .cart-button span {
    display: inline-grid;
    place-items: center;
    min-width: 1.5rem;
    height: 1.5rem;
    padding-inline: 0.375rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper-soft);
    font-size: 0.75rem;
  }

  /* Seven entries, login and cart in one bar: tighter spacing until the bar has room. */
  @media (min-width: 64rem) and (max-width: 84.99rem) {
    .site-header__bar {
      gap: var(--s-4);
    }

    .site-nav {
      gap: 1rem;
    }

    .site-nav ul {
      gap: 0.875rem;
    }

    .site-nav__secondary,
    .site-nav__account {
      padding-left: 1rem !important;
    }
  }

  /* On narrow screens the announcement takes two lines. */
  @media (max-width: 47.99rem) {
    .site-header {
      --announce-h: 2.75rem;
    }

    .announcement__text {
      letter-spacing: 0.1em;
    }
  }

  /* ------------------------------------------------------------ compact navigation */
  @media (max-width: 63.99rem) {
    .menu-toggle {
      display: inline-flex;
      align-items: center;
      gap: 0.75rem;
      min-height: 2.75rem;
      padding: 0 0.25rem 0 0.75rem;
      margin-right: -0.25rem;
      border: 0;
      background: none;
      font-size: 0.875rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      cursor: pointer;
      position: relative;
      z-index: 2;
    }

    .menu-toggle__icon {
      position: relative;
      width: 1.5rem;
      height: 0.625rem;
    }

    .menu-toggle__icon i {
      position: absolute;
      left: 0;
      right: 0;
      height: 1.5px;
      background: currentColor;
      transition: transform 0.25s var(--ease-out);
    }

    .menu-toggle__icon i:first-child {
      top: 0;
    }

    .menu-toggle__icon i:last-child {
      bottom: 0;
    }

    .menu-toggle[aria-expanded='true'] .menu-toggle__icon i:first-child {
      transform: translateY(4.25px) rotate(45deg);
    }

    .menu-toggle[aria-expanded='true'] .menu-toggle__icon i:last-child {
      transform: translateY(-4.25px) rotate(-45deg);
    }

    .wordmark {
      position: relative;
      z-index: 2;
    }

    .site-nav {
      position: fixed;
      inset: 0;
      z-index: 1;
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-start;
      gap: var(--s-6);
      /* clears the bar also while the announcement is still in view above it */
      padding: calc(var(--announce-h) + var(--header-h) + 1.5rem) var(--gutter) 2rem;
      background: var(--paper);
      overflow-y: auto;
      visibility: hidden;
      opacity: 0;
      transition:
        opacity 0.22s var(--ease-out),
        visibility 0s linear 0.22s;
    }

    .site-nav:global(.is-open) {
      visibility: visible;
      opacity: 1;
      transition:
        opacity 0.22s var(--ease-out),
        visibility 0s;
    }

    .site-nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .site-nav__primary a {
      font-family: var(--font-display), Georgia, serif;
      font-size: clamp(1.875rem, 7.5vw, 2.5rem);
      font-weight: 500;
      line-height: 1.1;
      letter-spacing: -0.01em;
      padding-block: 0.625rem;
      min-height: 3.5rem;
      width: 100%;
      border-bottom: 1px solid var(--rule);
      background: none;
    }

    .site-nav__primary a[aria-current='page'] {
      color: var(--saffron-deep);
    }

    .site-nav__secondary,
    .site-nav__account {
      padding-left: 0 !important;
      border-left: 0;
    }

    .site-nav__secondary a,
    .site-nav__account a {
      font-size: 1.0625rem;
      min-height: 3rem;
    }
  }

  /* Without JavaScript the compact menu cannot open: show it as a plain list instead. */
  @media (max-width: 63.99rem) {
    :global(html:not(.js)) .site-header {
      position: static;
      margin-bottom: 0;
    }

    :global(html:not(.js)) .site-header__bar {
      height: auto;
      flex-wrap: wrap;
      padding-block: var(--s-3);
    }

    :global(html:not(.js)) .menu-toggle {
      display: none;
    }

    :global(html:not(.js)) .site-nav {
      position: static;
      visibility: visible;
      opacity: 1;
      padding: 0 0 var(--s-4);
      width: 100%;
      background: none;
      gap: var(--s-3);
    }

    :global(html:not(.js)) .site-nav__primary a {
      font-family: inherit;
      font-size: 1rem;
      min-height: 2.75rem;
    }
  }
</style>
