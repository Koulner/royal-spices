# Public site URL used for canonical links, sitemap and Open Graph.
SITE_URL=https://royalspices.de

# --- Inquiry delivery (server only) -------------------------------------------
# Without these, production answers inquiries with a clear "please call or e-mail" error
# instead of dropping them. In development, inquiries are appended to .data/inquiries.jsonl.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# INQUIRY_TO=info@royalspices.de
# INQUIRY_FROM="Royal Spices Website <website@royalspices.de>"

# --- Shopify Storefront (public by design) --------------------------------------
# Leave empty until the store exists. No private Admin API token belongs in this project.
# PUBLIC_SHOPIFY_STORE_DOMAIN=royal-spices.myshopify.com
# PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
# PUBLIC_SHOPIFY_API_VERSION=2026-07

# --- Server ---------------------------------------------------------------------
# HOST=127.0.0.1
# PORT=4321
# Set to 1 only behind a reverse proxy you control; enables X-Forwarded-For for rate limiting.
# TRUST_PROXY=0
